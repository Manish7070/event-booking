{
  "name": "eventra-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build:server && npm run build:client",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "typecheck": "npm run typecheck --prefix server && npm run typecheck --prefix client",
    "lint": "npm run lint --prefix server && npm run lint --prefix client",
    "db:seed": "npm run db:seed --prefix server",
    "test": "npm run test --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.46.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22"
  }
}
