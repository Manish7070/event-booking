# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# DATABASE
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/eventra?retryWrites=true&w=majority

# AUTHENTICATION
JWT_SECRET=super-secret-jwt-key-eventra-production-2026
JWT_EXPIRES_IN=7d

# PAYMENTS (RAZORPAY)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_key

# FILE UPLOADS (CLOUDINARY)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=demo_api_secret

# EMAIL (SMTP / RESEND)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=noreply@eventra.com
EMAIL_PASS=smtp_password
EMAIL_FROM=Eventra Support <noreply@eventra.com>
